{
  "name": "innocenceharness",
  "productName": "InnocenceHarness",
  "author": "逆流无邪",
  "version": "0.1.0",
  "description": "InnocenceHarness AI coding assistant desktop client",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgs844575/innocence-code.git"
  },
  "bugs": {
    "url": "https://github.com/sgs844575/innocence-code/issues"
  },
  "homepage": "https://github.com/sgs844575/innocence-code#readme",
  "main": ".vite/build/main.js",
  "workspaces": [
    "packages/*",
    "vendor/*"
  ],
  "scripts": {
    "start": "electron-forge start",
    "prestart": "npm run build:plugins",
    "dev": "electron-forge start",
    "dev-npm": "npm run dev",
    "predev": "npm run build:plugins",
    "build:plugins": "node scripts/build-plugins.mjs",
    "prepackage": "npm run package:preflight && npm run build:plugins",
    "package": "electron-forge package",
    "package:preflight": "node --experimental-strip-types --experimental-default-type=module scripts/packaging/outPreflight.ts",
    "package:smoke": "node --experimental-strip-types --experimental-default-type=module scripts/packaging/runPackageSmoke.ts",
    "icons:icns": "node --experimental-strip-types --experimental-default-type=module scripts/packaging/generateIconIcns.ts",
    "premake": "npm run build:plugins",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "npm run typecheck --workspaces --if-present",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --maxWorkers=10",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "42.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.71",
    "@ai-sdk/google": "3.0.64",
    "@ai-sdk/openai": "3.0.53",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fiahfy/icns": "^0.0.7",
    "@innocenceharness/plugin-skills": "^0.1.0",
    "@larksuiteoapi/node-sdk": "1.61.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "6.0.159",
    "class-variance-authority": "^0.7.1",
    "diff": "^9.0.0",
    "lucide-react": "^0.545.0",
    "module-details-from-path": "^1.0.4",
    "node-forge": "^1.4.0",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "1.59.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.7.4",
    "shiki": "^4.4.3",
    "ssh2": "^1.16.0",
    "streamdown": "^2.5.0",
    "undici": "^6.23.0",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "yazl": "^3.3.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
